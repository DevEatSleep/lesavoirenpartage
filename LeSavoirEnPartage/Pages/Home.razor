@page "/"
@inject JourneyService Journeys
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Le Savoir en partage — Le Voyageur du savoir</PageTitle>
<section class="hero fun-hero">
    <div class="hero-copy"><div class="eyebrow"><span class="eyebrow-dot"></span> 3 MINUTES POUR ÊTRE SURPRIS</div>
        <h1>La curiosité<br/><em>n’a pas de bouton pause.</em></h1>
        <p>Des mystères, des défis, des animaux incroyables et des faits qui semblent impossibles. Tu devines, tu découvres, puis tu vérifies.</p>
        <div class="hero-actions"><a class="button button-primary" href="#explorer">Choisir mon univers <span>↗</span></a><a class="text-link" href="carte">Voir la carte <span>→</span></a></div>
        <div class="hero-note"><span class="note-symbol">✳</span><span>Amusant, mais sérieux sur les faits.<br/><strong>Pas de légende présentée comme une vérité.</strong></span></div>
    </div>
    <div class="hero-art fun-hero-art" aria-label="Huit portes vers des univers de découverte"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="planet planet-main">✦<small>CURIEUX ?</small></div><div class="planet planet-brain">🔎<small>MYSTÈRES</small></div><div class="planet planet-history">🎬<small>POP CULTURE</small></div><div class="planet planet-philo">🧠<small>DÉFIS</small></div><div class="planet planet-art">🐙<small>NATURE</small></div><div class="art-caption">Une surprise en entraîne une autre.</div></div>
</section>
<section class="explore-section" id="explorer">
    <div class="section-heading"><div><div class="eyebrow">HUIT UNIVERS À EXPLORER</div><h2>Qu’est-ce qui t’intrigue aujourd’hui ?</h2></div><span class="section-count">08 UNIVERS</span></div>
    <div class="journey-grid">
        @foreach (var j in Journeys.All)
        {
            <button class="journey-card fun-card" @onclick="() => OpenJourney(j.Id)"><div class="card-top"><span class="card-icon">@j.Icon</span><span class="card-arrow">↗</span></div><span class="card-category">@j.Category</span><h3>@j.Title</h3><p>@j.Question</p><span class="card-bottom">Découvrir <span>→</span></span></button>
        }
    </div>
</section>
<section class="daily-challenge"><div class="daily-challenge-top"><span class="daily-icon">⚡</span><div><div class="eyebrow">LE DÉFI DU VOYAGEUR</div><h2>Vrai ou faux ?</h2></div><span class="challenge-time">30 secondes</span></div><p class="challenge-question">Les pieuvres possèdent trois cœurs.</p><div class="challenge-actions"><button class="button button-secondary" @onclick='() => AnswerQuiz("vrai")'>Vrai</button><button class="button button-secondary" @onclick='() => AnswerQuiz("faux")'>Faux</button></div>@if (_quizAnswered){<div class="challenge-answer"><strong>@(_quizChoice == "vrai" ? "Bien joué !" : "Pas tout à fait !")</strong><p>La bonne réponse est vrai : deux cœurs pompent le sang vers les branchies, et le troisième l’envoie vers le reste du corps. <a href="https://fr.wikipedia.org/wiki/Poulpe" target="_blank" rel="noopener">Vérifier la source ↗</a></p><button class="text-button" @onclick="ResetQuiz">Rejouer</button></div>}</section>
<section class="mini-loop"><div><div class="eyebrow">LE PETIT RITUEL DU VOYAGEUR</div><h2>Devine. Découvre. Vérifie.</h2></div><div class="mini-loop-steps"><div><span>01</span><strong>Fais ton pari</strong><p>Réponds avec ton intuition, sans chercher.</p></div><div><span>02</span><strong>Découvre le pourquoi</strong><p>Une explication claire, courte et accessible.</p></div><div><span>03</span><strong>Remonte à la source</strong><p>Garde ton esprit critique et explore plus loin.</p></div></div></section>
<section class="manifesto" id="manifeste"><div class="manifesto-symbol">“</div><div><div class="eyebrow">NOTRE RÈGLE DU JEU</div><h2>Le plaisir de la découverte.<br/><em>La vérité comme boussole.</em></h2><p>Une histoire douteuse peut être fascinante, mais elle reste une question à vérifier. Les sources humaines sont le point de départ ; l’IA peut aider à explorer, jamais remplacer les preuves ni l’esprit critique.</p><div class="manifesto-links"><a class="text-link" href="https://www.wikimedia.org/" target="_blank" rel="noopener noreferrer">Découvrir le mouvement Wikimedia ↗</a><a class="button button-secondary donate-button" href="https://donate.wikimedia.org/" target="_blank" rel="noopener noreferrer">♥ Soutenir Wikipédia par un don ↗</a></div></div></section>
@code {
    private bool _quizAnswered;
    private string _quizChoice = "";
    private void AnswerQuiz(string choice) { _quizChoice = choice; _quizAnswered = true; }
    private void ResetQuiz() { _quizAnswered = false; _quizChoice = ""; }
    private void OpenJourney(string id) => Nav.NavigateTo($"voyage/{id}");
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("lspInitLanguage"); else await JS.InvokeVoidAsync("lspTranslateUi"); }
}
