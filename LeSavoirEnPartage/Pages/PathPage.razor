@page "/parcours/{Id}/{Index:int}"
@inject JourneyService Journeys
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Une nouvelle piste — Le Savoir en partage</PageTitle>
@if (_journey is not null && Index >= 0 && Index < _journey.Paths.Length)
{
    <section class="journey-detail path-detail"><a class="back-link" href="voyage/@Id">← Retour au voyage</a><div class="eyebrow">UNE NOUVELLE PISTE</div><h1>@_journey.Paths[Index]</h1><p class="detail-question">@_journey.PathQuestions[Index]</p><div class="path-prompt"><span class="path-prompt-mark">✳</span><h2>La curiosité est le début du voyage.</h2><p>Commence par formuler une hypothèse, puis consulte une source de référence. Cherche ce que tu comprends déjà, ce qui t’étonne et les nouvelles questions qui apparaissent.</p>@if (HasFact && HasClaim){<div class="learning-panel">@if (_bet is null){<div @key="@($"{NoteId}-open")"><h2>Vrai ou faux ?</h2><p class="bet-claim">@ClaimText</p><div class="bet-choices"><button type="button" class="@ChoiceClass(true)" aria-pressed="@(_answer == true)" @onclick="() => _answer = true">Vrai</button><button type="button" class="@ChoiceClass(false)" aria-pressed="@(_answer == false)" @onclick="() => _answer = false">Faux</button></div><p id="path-confidence-label" class="bet-label">À quel point es-tu sûr ?</p><div class="bet-choices" role="group" aria-labelledby="path-confidence-label"><button type="button" class="@LevelClass(60)" aria-pressed="@(_confidence == 60)" @onclick="() => _confidence = 60">Je devine</button><button type="button" class="@LevelClass(80)" aria-pressed="@(_confidence == 80)" @onclick="() => _confidence = 80">Plutôt sûr</button><button type="button" class="@LevelClass(100)" aria-pressed="@(_confidence == 100)" @onclick="() => _confidence = 100">Certain</button></div><label for="path-hypothesis">Pourquoi ? (facultatif)</label><textarea id="path-hypothesis" @bind="_hypothesis" @bind:event="oninput" placeholder="Je pense que…"></textarea>@if (!CanBet){<p class="source-disclaimer">Choisis Vrai ou Faux, puis ton niveau de confiance.</p>}<button class="button button-primary" disabled="@(!CanBet)" @onclick="PlaceBet">Parier ↗</button></div>}else{<div @key="@($"{NoteId}-result")">@if (_bet.Correct){<h2 @key="@($"{NoteId}-ok")">Bien vu !</h2>}else{<h2 @key="@($"{NoteId}-ko")">Raté.</h2>}<p class="bet-claim">@ClaimText</p><p><strong>La bonne réponse était :</strong> @if (ClaimTruth){<span @key="@($"{NoteId}-t")">Vrai</span>}else{<span @key="@($"{NoteId}-f")">Faux</span>}</p><p><strong>Ton pari :</strong> @if (_bet.Answer){<span @key="@($"{NoteId}-bt")">Vrai</span>}else{<span @key="@($"{NoteId}-bf")">Faux</span>} <span class="bet-confidence">@($"{_bet.Confidence} %")</span></p>@if (!string.IsNullOrWhiteSpace(_hypothesis)){<p><strong>Tu pensais :</strong> <span>@_hypothesis</span></p>}<h2>Ce que dit la source</h2><p>@FactText</p><p class="source-disclaimer"><span>Source :</span> <a href="@FactSourceUrl" target="_blank" rel="noopener noreferrer">@(FactSourceName + " ↗")</a></p><button class="button button-secondary" @onclick="ReplayBet">Rejouer cette piste</button></div>}</div>}<div class="source-links"><a class="button button-primary" href="@PathSourceUrlFor(_language)" data-source-fr="@PathSourceUrlForFrench()" data-source-en="@PathSourceUrlForEnglish()" data-source-es="@PathSourceUrlForSpanish()" target="_blank" rel="noopener noreferrer">Lire l’article lié à cette piste sur Wikipédia ↗</a><a href="@SecondarySourceUrl()" target="_blank" rel="noopener noreferrer">Croiser avec : @SecondarySourceName() ↗</a></div><p class="source-disclaimer">Un lien est un point de départ, pas une preuve suffisante à lui seul. Vérifie les références et la date des informations.</p></div><button class="button button-secondary" @onclick="SavePath">@(_saved ? "✓ Piste enregistrée" : "+ Enregistrer cette piste")</button>
    </section>
}
else { <section class="empty-state"><h1>Cette piste n’existe pas encore.</h1><a href="./">Explorer les voyages</a></section> }
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("lspTranslateUi"); }
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public int Index { get; set; }
    private Journey? _journey;
    private bool _saved;
    private string _language = "fr";
    private string _hypothesis = "";
    private Bet? _bet;
    private bool? _answer;
    private int? _confidence;
    private bool HasFact => _journey is not null && Index >= 0 && Index < _journey.PathFacts.Length && Index < _journey.PathFactSourceNames.Length && Index < _journey.PathFactSourceUrls.Length;
    private string FactText => HasFact ? _journey!.PathFacts[Index] : "";
    private string FactSourceName => HasFact ? _journey!.PathFactSourceNames[Index] : "";
    private string FactSourceUrl => HasFact ? _journey!.PathFactSourceUrls[Index] : "https://www.wikipedia.org/";
    private string NoteId => $"{Id}-path-{Index}";
    private bool HasClaim => _journey is not null && Index >= 0 && Index < _journey.PathClaims.Length && Index < _journey.PathClaimTruths.Length;
    private string ClaimText => HasClaim ? _journey!.PathClaims[Index] : "";
    private bool ClaimTruth => HasClaim && _journey!.PathClaimTruths[Index];
    private bool CanBet => _answer is not null && _confidence is not null;
    private string LevelClass(int value) => _confidence == value ? "bet-choice bet-choice-selected" : "bet-choice";
    private string ChoiceClass(bool value) => _answer == value ? "bet-choice bet-choice-selected" : "bet-choice";
    private async Task PlaceBet()
    {
        if (_answer is null || _confidence is null || !HasClaim) return;
        var correct = _answer.Value == ClaimTruth;
        await JS.InvokeVoidAsync("lspSetBet", NoteId, _answer.Value, _confidence.Value, correct);
        await JS.InvokeVoidAsync("lspSetNote", NoteId, _hypothesis);
        _bet = new Bet { Answer = _answer.Value, Confidence = _confidence.Value, Correct = correct };
    }
    private async Task ReplayBet() { await JS.InvokeVoidAsync("lspClearBet", NoteId); _bet = null; _answer = null; _confidence = null; }
    protected override async Task OnParametersSetAsync() { _journey = Journeys.Find(Id); _answer = null; _confidence = null; _bet = await JS.InvokeAsync<Bet?>("lspGetBet", NoteId); _hypothesis = await JS.InvokeAsync<string>("lspGetNote", NoteId); _saved = await JS.InvokeAsync<bool>("lspIsSaved", $"{Id}-path-{Index}"); _language = await JS.InvokeAsync<string>("lspGetLanguage"); }
    private async Task SavePath() { _saved = !_saved; await JS.InvokeVoidAsync("lspSave", $"{Id}-path-{Index}", _saved); }
    private string PathSourceUrlForFrench() => PathSourceUrlFor("fr");
    private string PathSourceUrlForEnglish() => PathSourceUrlFor("en");
    private string PathSourceUrlForSpanish() => PathSourceUrlFor("es");
    private string PathSourceUrlFor(string lang) { if (_journey is null || Index < 0) return "https://www.wikipedia.org/"; return lang switch { "en" when Index < _journey.PathSourceUrlsEnglish.Length => _journey.PathSourceUrlsEnglish[Index], "es" when Index < _journey.PathSourceUrlsSpanish.Length => _journey.PathSourceUrlsSpanish[Index], _ when Index < _journey.PathSourceUrls.Length => _journey.PathSourceUrls[Index], _ => "https://www.wikipedia.org/" }; }
    private string SecondarySourceUrl() => _journey?.SecondarySourceUrl ?? "https://www.wikimedia.org/";
    private string SecondarySourceName() => _journey?.SecondarySourceName ?? "une source complémentaire";
}
