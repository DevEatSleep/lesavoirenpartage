@page "/parcours/{Id}/{Index:int}"
@inject JourneyService Journeys
@inject NavigationManager Nav
@inject IJSRuntime JS
<PageTitle>Une nouvelle piste — Le Savoir en partage</PageTitle>
@if (_journey is not null && Index >= 0 && Index < _journey.Paths.Length)
{
    <section class="journey-detail path-detail"><a class="back-link" href="/voyage/@Id">← Retour au voyage</a><div class="eyebrow">UNE NOUVELLE PISTE</div><h1>@_journey.Paths[Index]</h1><p class="detail-question">@_journey.PathQuestions[Index]</p><div class="path-prompt"><span class="path-prompt-mark">✳</span><h2>La curiosité est le début du voyage.</h2><p>Commence par formuler une hypothèse, puis consulte une source de référence. Cherche ce que tu comprends déjà, ce qui t’étonne et les nouvelles questions qui apparaissent.</p><div class="source-links"><a class="button button-primary" href="@PathSourceUrlFor(_language)" data-source-fr="@PathSourceUrlForFrench()" data-source-en="@PathSourceUrlForEnglish()" data-source-es="@PathSourceUrlForSpanish()" target="_blank" rel="noopener noreferrer">Lire l’article lié à cette piste sur Wikipédia ↗</a><a href="@SecondarySourceUrl()" target="_blank" rel="noopener noreferrer">Croiser avec : @SecondarySourceName() ↗</a></div><p class="source-disclaimer">Un lien est un point de départ, pas une preuve suffisante à lui seul. Vérifie les références et la date des informations.</p></div><button class="button button-secondary" @onclick="SavePath">@(_saved ? "✓ Piste enregistrée" : "+ Enregistrer cette piste")</button>
    </section>
}
else { <section class="empty-state"><h1>Cette piste n’existe pas encore.</h1><a href="/">Explorer les voyages</a></section> }
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("lspTranslateUi"); }
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public int Index { get; set; }
    private Journey? _journey;
    private bool _saved;
    private string _language = "fr";
    protected override async Task OnParametersSetAsync() { _journey = Journeys.Find(Id); _saved = await JS.InvokeAsync<bool>("lspIsSaved", $"{Id}-path-{Index}"); _language = await JS.InvokeAsync<string>("lspGetLanguage"); }
    private async Task SavePath() { _saved = !_saved; await JS.InvokeVoidAsync("lspSave", $"{Id}-path-{Index}", _saved); }
    private string PathSourceUrlForFrench() => PathSourceUrlFor("fr");
    private string PathSourceUrlForEnglish() => PathSourceUrlFor("en");
    private string PathSourceUrlForSpanish() => PathSourceUrlFor("es");
    private string PathSourceUrlFor(string lang) { if (_journey is null || Index < 0) return "https://www.wikipedia.org/"; return lang switch { "en" when Index < _journey.PathSourceUrlsEnglish.Length => _journey.PathSourceUrlsEnglish[Index], "es" when Index < _journey.PathSourceUrlsSpanish.Length => _journey.PathSourceUrlsSpanish[Index], _ when Index < _journey.PathSourceUrls.Length => _journey.PathSourceUrls[Index], _ => "https://www.wikipedia.org/" }; }
    private string SecondarySourceUrl() => _journey?.SecondarySourceUrl ?? "https://www.wikimedia.org/";
    private string SecondarySourceName() => _journey?.SecondarySourceName ?? "une source complémentaire";
}
